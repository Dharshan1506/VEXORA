# VEXORA Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.

# ── Authentication ─────────────────────────────────────────────────────────────
# JWT Secret Key — use a long random string (64+ chars) in production
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path or future PostgreSQL connection URI
DATABASE_URL=sqlite:///vexora_knowledge.db

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Provider: 'gemini' (default) or 'openai' (for OpenAI, Groq, Ollama, vLLM)
LLM_PROVIDER=gemini

# Gemini API Key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash

# Alternative: for OpenAI-compatible APIs, set LLM_API_KEY and LLM_BASE_URL
# LLM_API_KEY=your-openai-or-groq-key-here
# LLM_BASE_URL=https://api.openai.com/v1

# ── Embedding Configuration ────────────────────────────────────────────────────
# Provider: 'sentence-transformers' (default local CPU/GPU) or 'gemini'
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking Configuration ────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_WORDS=30

# ── Hybrid Retrieval & Reranker ───────────────────────────────────────────────
BM25_TOP_K=10
VECTOR_TOP_K=10
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# ── Evidence Guard Thresholds ──────────────────────────────────────────────────
# Minimum cross-encoder reranker score to consider evidence sufficient
# Range: typically -10 to +10 for ms-marco model; 0.15 is conservative
EVIDENCE_SCORE_THRESHOLD=0.15

# Minimum number of chunks required to answer (set to 1 for permissive)
EVIDENCE_MIN_CHUNKS=1

# ── Debug Mode ────────────────────────────────────────────────────────────────
# Set to true to log full BM25/vector/RRF/reranker pipeline details per query
DEBUG_RETRIEVAL=false
