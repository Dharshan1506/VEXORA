# VEXORA Environment Variables — DO NOT COMMIT THIS FILE
# See .env.example for documentation of all variables.

# ── Authentication ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash

# ── Evidence Guard ─────────────────────────────────────────────────────────────
EVIDENCE_SCORE_THRESHOLD=0.15
EVIDENCE_MIN_CHUNKS=1

# ── Debug Mode ────────────────────────────────────────────────────────────────
# Set to true to enable verbose pipeline logging in console
DEBUG_RETRIEVAL=false
